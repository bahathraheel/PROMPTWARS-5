# ================================================================
# PLANEN AI — Comprehensive .gitignore
# Protects ALL secrets, credentials, and generated files
# ================================================================

# ── Dependency Directories ───────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/
shared/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build & Dist Outputs ─────────────────────────────────────────
client/dist/
client/build/
client/.vite/
server/dist/
server/build/
*.tsbuildinfo

# ══════════════════════════════════════════════════════════════════
#  SECRETS — NEVER COMMIT ANY OF THESE
# ══════════════════════════════════════════════════════════════════

# Root environment files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# Client environment files (Vite)
client/.env
client/.env.local
client/.env.development
client/.env.development.local
client/.env.test.local
client/.env.production
client/.env.production.local

# Server environment files
server/.env
server/.env.local
server/.env.development
server/.env.test
server/.env.production

# Firebase & Google service account credentials
serviceAccountKey.json
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json
google-credentials*.json
gcloud-key*.json
credentials.json

# Private keys
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_ed25519

# JWT / OAuth tokens
*.token
*.secret
auth_token*

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server/logs/

# ── Test Coverage & Reports ──────────────────────────────────────
client/coverage/
server/coverage/
.nyc_output/

# ── OS Generated Files ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor & IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# ── TypeScript Compiled Output ───────────────────────────────────
*.js.map
*.d.ts.map

# ── Vite Cache ───────────────────────────────────────────────────
.vite/

# ── Misc ─────────────────────────────────────────────────────────
*.tgz
*.zip
tmp/
temp/
.tmp/
.cache/
