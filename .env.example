# ============================================
# PLANEN AI — Environment Variables Template
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# ---- Google Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=8192

# ---- Firebase (Server-side Admin SDK) ----
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ---- Server Configuration ----
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20

# ---- Google OAuth (for Calendar / Gmail) ----
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ---- Google Maps & Places ----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- Google Calendar ----
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events

# ---- Gmail API ----
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send

# ---- Client-side Firebase (Vite env — prefix with VITE_) ----
# Add these to client/.env or client/.env.local
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_API_BASE_URL=http://localhost:3001
